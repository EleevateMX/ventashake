respaldo-costosshake-*.json

# La app nativa se REGENERA, no se versiona. El proyecto de Xcode y el de
# Android salen de capacitor.config.ts + scripts/app-nativa-preparar.sh en
# cada compilacion. Versionarlos invita a arreglar algo a mano en Xcode y
# perderlo en el siguiente `cap sync`, sin ningun error que lo delate.
apps/cliente-pwa/ios/
apps/cliente-pwa/android/

# Los instaladores que Admin sirve se COPIAN en cada build desde scripts/.
# Versionarlos aqui seria tener dos copias del mismo .bat, y en cuanto
# alguien tocara una, Admin repartiria un instalador viejo sin enterarse.
apps/admin/public/descargas/
