# Agente de PANTALLAS de Shakeaholic.
#
# Mantiene cada television mostrando lo que Admin le asigno. Corre en la
# misma PC que los otros agentes, como proceso aparte: si este se cae, las
# comandas y los tickets siguen saliendo.

SUPABASE_URL=https://zyjtnaystsporbuzcmqk.supabase.co
SUPABASE_ANON_KEY=

# Funcion de la base que dice que muestra cada tele.
# Debe devolver filas con al menos:  ip  y  url
# Opcionales: nombre, tipo ('imagen'|'video'), titulo, activa
RPC_ASIGNACIONES=

# Funcion opcional para devolver el estado real de cada pantalla.
# Recibe  p_reportes  (arreglo json). Si se deja vacia, el estado solo sale
# por consola y Admin no se entera.
RPC_REPORTE=

# Solo para probar sin la funcion todavia: un JSON local con las mismas
# filas. Si esta puesto, MANDA sobre RPC_ASIGNACIONES.
ASIGNACIONES_ARCHIVO=

CICLO_SEGUNDOS=20
REDESCUBRIR_SEGUNDOS=300
