# Agente de PANTALLAS de Shakeaholic.
#
# Mantiene cada television mostrando lo que gerencia le asigno en
# Admin -> Pantallas (TV), rotando las imagenes y reenganchandola si
# alguien le cambio la entrada. Ver docs/pantallas-tv.md.
#
# Corre en la PC de la tienda como proceso APARTE de los otros agentes:
# si este se cae, comandas y tickets siguen saliendo.

SUPABASE_URL=https://zyjtnaystsporbuzcmqk.supabase.co
SUPABASE_ANON_KEY=

# Llave del empujador: Admin -> Pantallas -> "Generar llave del empujador".
# Se ve UNA SOLA VEZ (la base guarda solo su hash) y generar otra invalida
# la anterior. Va aqui y en ningun otro lado: ni en el repo, ni en un chat.
PANTALLAS_TOKEN=

RPC_ASIGNACIONES=fn_pantallas_tv_agente
RPC_REPORTE=fn_pantallas_tv_reportar

# Nombre con el que esta PC aparece en Admin. Vacio = nombre del equipo.
AGENTE_NOMBRE=

# Cada cuanto se pide la asignacion. Es tambien el latido, y el contrato
# pide entre 30 y 60 s: fuera de ese rango se ajusta solo.
CICLO_SEGUNDOS=45

# Reporte forzado por TV aunque no cambie nada. El contrato pide maximo
# 2 minutos; a los 3 Admin la pinta como "sin reporte".
REPORTE_SEGUNDOS=90

REDESCUBRIR_SEGUNDOS=300

# 1 = registrar cada avance de diapositiva. Util al instalar para ver que
# rota de verdad; a diario llena el log.
VERBOSO=

# Solo para probar sin tocar la base: un JSON con la misma forma que
# devuelve fn_pantallas_tv_agente. Si esta puesto, MANDA sobre el RPC.
ASIGNACIONES_ARCHIVO=
